customUI.triggerVolumeEffectEditor.field.Camera.Custom = Custom
customUI.triggerVolumeEffectEditor.field.Camera.Custom.tooltip = If enabled, the camera will use the custom settings below. If disabled, it will set the default first-person camera.
customUI.triggerVolumeEffectEditor.field.Camera.Absolute = Absolute
customUI.triggerVolumeEffectEditor.field.Camera.Absolute.tooltip = If enabled, the camera will use absolute coordinates. If disabled, it will use coordinates relative to the player.
customUI.triggerVolumeEffectEditor.field.Camera.LookAtPlayer = Look at Player
customUI.triggerVolumeEffectEditor.field.Camera.LookAtPlayer.tooltip = If enabled, the camera will always look at the player. If disabled, it will use the rotation specified in the Rotation field.
customUI.triggerVolumeEffectEditor.field.Camera.Position = Position
customUI.triggerVolumeEffectEditor.field.Camera.Position.tooltip = Position of the camera. X, Y, Z order.
customUI.triggerVolumeEffectEditor.field.Camera.Rotation = Rotation (degrees)
customUI.triggerVolumeEffectEditor.field.Camera.Rotation.tooltip = Rotation of the camera in degrees. Pitch, Yaw, Roll order.
customUI.triggerVolumeEffectEditor.field.Camera.PositionLerpSpeed = Position Transition Speed
customUI.triggerVolumeEffectEditor.field.Camera.PositionLerpSpeed.tooltip = Controls how quickly the camera moves toward its target position. Lower values create a slower, smoother transition. Default: 0.15.
customUI.triggerVolumeEffectEditor.field.Camera.RotationLerpSpeed = Rotation Transition Speed
customUI.triggerVolumeEffectEditor.field.Camera.RotationLerpSpeed.tooltip = Controls how quickly the camera rotates toward its target orientation. Lower values create a slower, smoother transition. Default: 0.15.
customUI.triggerVolumeEffectEditor.field.CameraAlongPath.PathStart = Path Start
customUI.triggerVolumeEffectEditor.field.CameraAlongPath.PathStart.tooltip = World position marking the beginning of the camera path. X, Y, Z order.
customUI.triggerVolumeEffectEditor.field.CameraAlongPath.PathEnd = Path End
customUI.triggerVolumeEffectEditor.field.CameraAlongPath.PathEnd.tooltip = World position marking the end of the camera path. X, Y, Z order.
customUI.triggerVolumeEffectEditor.field.CameraAlongPath.CameraStartOffset = Starting Camera Offset
customUI.triggerVolumeEffectEditor.field.CameraAlongPath.CameraStartOffset.tooltip = Camera offset relative to the player at the beginning of the path. X, Y, Z order.
customUI.triggerVolumeEffectEditor.field.CameraAlongPath.CameraEndOffset = Ending Camera Offset
customUI.triggerVolumeEffectEditor.field.CameraAlongPath.CameraEndOffset.tooltip = Camera offset relative to the player at the end of the path. X, Y, Z order.
customUI.triggerVolumeEffectEditor.field.CameraAlongPath.CameraStartRotation = Starting Camera Rotation (degrees)
customUI.triggerVolumeEffectEditor.field.CameraAlongPath.CameraStartRotation.tooltip = Camera rotation at the beginning of the path. Pitch, Yaw, Roll order.
customUI.triggerVolumeEffectEditor.field.CameraAlongPath.CameraEndRotation = Ending Camera Rotation (degrees)
customUI.triggerVolumeEffectEditor.field.CameraAlongPath.CameraEndRotation.tooltip = Camera rotation at the end of the path. Pitch, Yaw, Roll order.
customUI.triggerVolumeEffectEditor.field.CameraAlongPath.PositionLerpSpeed = Position Transition Speed
customUI.triggerVolumeEffectEditor.field.CameraAlongPath.PositionLerpSpeed.tooltip = Controls how quickly the camera moves toward its calculated position. Lower values create a slower, smoother response. Default: 0.15.
customUI.triggerVolumeEffectEditor.field.CameraAlongPath.RotationLerpSpeed = Rotation Transition Speed
customUI.triggerVolumeEffectEditor.field.CameraAlongPath.RotationLerpSpeed.tooltip = Controls how quickly the camera rotates toward its calculated orientation. Lower values create a slower, smoother response. Default: 0.15.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathWorldLocked.PathStart = Path Start
customUI.triggerVolumeEffectEditor.field.CameraAlongPathWorldLocked.PathStart.tooltip = World position marking the beginning of the camera path. X, Y, Z order.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathWorldLocked.PathEnd = Path End
customUI.triggerVolumeEffectEditor.field.CameraAlongPathWorldLocked.PathEnd.tooltip = World position marking the end of the camera path. X, Y, Z order.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathWorldLocked.CameraStartOffset = Starting Camera Offset
customUI.triggerVolumeEffectEditor.field.CameraAlongPathWorldLocked.CameraStartOffset.tooltip = World-aligned camera offset from the player at the beginning of the path. X, Y, Z order.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathWorldLocked.CameraEndOffset = Ending Camera Offset
customUI.triggerVolumeEffectEditor.field.CameraAlongPathWorldLocked.CameraEndOffset.tooltip = World-aligned camera offset from the player at the end of the path. X, Y, Z order.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathWorldLocked.CameraStartRotation = Starting Camera Rotation (degrees)
customUI.triggerVolumeEffectEditor.field.CameraAlongPathWorldLocked.CameraStartRotation.tooltip = World-space camera rotation at the beginning of the path. Pitch, Yaw, Roll order.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathWorldLocked.CameraEndRotation = Ending Camera Rotation (degrees)
customUI.triggerVolumeEffectEditor.field.CameraAlongPathWorldLocked.CameraEndRotation.tooltip = World-space camera rotation at the end of the path. Pitch, Yaw, Roll order.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathWorldLocked.PositionLerpSpeed = Position Transition Speed
customUI.triggerVolumeEffectEditor.field.CameraAlongPathWorldLocked.PositionLerpSpeed.tooltip = Controls how quickly the camera moves toward its calculated world position. Default: 0.15.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathWorldLocked.RotationLerpSpeed = Rotation Transition Speed
customUI.triggerVolumeEffectEditor.field.CameraAlongPathWorldLocked.RotationLerpSpeed.tooltip = Controls how quickly the camera rotates toward its calculated world orientation. Default: 0.15.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathTrackPlayer.PathStart = Path Start
customUI.triggerVolumeEffectEditor.field.CameraAlongPathTrackPlayer.PathStart.tooltip = World position marking the beginning of the camera path. X, Y, Z order.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathTrackPlayer.PathEnd = Path End
customUI.triggerVolumeEffectEditor.field.CameraAlongPathTrackPlayer.PathEnd.tooltip = World position marking the end of the camera path. X, Y, Z order.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathTrackPlayer.CameraStartOffset = Starting Camera Offset
customUI.triggerVolumeEffectEditor.field.CameraAlongPathTrackPlayer.CameraStartOffset.tooltip = World-aligned camera offset from the player at the beginning of the path. X, Y, Z order.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathTrackPlayer.CameraEndOffset = Ending Camera Offset
customUI.triggerVolumeEffectEditor.field.CameraAlongPathTrackPlayer.CameraEndOffset.tooltip = World-aligned camera offset from the player at the end of the path. X, Y, Z order.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathTrackPlayer.LookAtHeight = Look At Height
customUI.triggerVolumeEffectEditor.field.CameraAlongPathTrackPlayer.LookAtHeight.tooltip = Height above the player's base that the camera aims toward. Default: 1.0.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathTrackPlayer.PositionLerpSpeed = Position Transition Speed
customUI.triggerVolumeEffectEditor.field.CameraAlongPathTrackPlayer.PositionLerpSpeed.tooltip = Controls how quickly the camera moves toward its calculated world position. Default: 0.15.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathTrackPlayer.RotationLerpSpeed = Rotation Transition Speed
customUI.triggerVolumeEffectEditor.field.CameraAlongPathTrackPlayer.RotationLerpSpeed.tooltip = Controls how quickly the camera turns toward the player. Default: 0.15.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.PathStart = Path Start (X, Y, Z)
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.PathStart.tooltip = World coordinates marking the entrance and beginning of the camera path. Left to right: X, Y (vertical height), Z.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.PathEnd = Path End (X, Y, Z)
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.PathEnd.tooltip = World coordinates marking the end of the camera path. Left to right: X, Y (vertical height), Z.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.EyeHeight = Eye Height
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.EyeHeight.tooltip = Height above the player's base where the camera begins. Default: 1.6.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.TransitionStartDistance = Transition Start Distance
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.TransitionStartDistance.tooltip = Distance beyond Path Start before the cinematic camera takes control. Default: 1.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.EntryAlignmentDistance = Entry Alignment Distance
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.EntryAlignmentDistance.tooltip = Distance used to smoothly align an unusual entry view with the forward path direction. The captured view is only the starting frame, not a permanent lock. Default: 2.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.MaxPullbackDistance = Maximum Pullback Distance
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.MaxPullbackDistance.tooltip = Maximum distance the camera moves backward from the player along the path. Default: 16.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.EndHeight = Ending Camera Heigh
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.EndHeight.tooltip = Additional height gained by the camera by the end of the path. Default: 5.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.TrackingStartPullback = Tracking Start Pullback
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.TrackingStartPullback.tooltip = Pullback distance reached before the camera begins aiming toward the player. This prevents the opening view from pitching downward while the camera is still near the head. Default: 2.5.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.TrackingBlendDistance = Tracking Blend Distance
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.TrackingBlendDistance.tooltip = Additional pullback distance over which the camera smoothly transitions into tracking the player. Default: 3.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.EndRollDegrees = Ending Camera Roll (Degrees)
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.EndRollDegrees.tooltip = Final camera tilt in degrees. Use a negative value to tilt in the opposite direction. Default: 2.5.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.RollMovementStart = Roll Movement Start
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.RollMovementStart.tooltip = Fraction of the cinematic path completed before the camera begins rolling. Use a value from 0 to 1. Default: 0.35.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.DoorwayClearance = Doorway Clearance
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.DoorwayClearance.tooltip = Space kept between the camera and Path Start so the camera does not cross the entrance wall. Default: 0.5.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.BacktrackCancelDistance = Backtrack Cancel Distance
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.BacktrackCancelDistance.tooltip = Distance moved back toward the entrance before the cinematic cancels and returns control. Default: 1.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.ReturnDurationSeconds = Return Duration (Seconds)
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.ReturnDurationSeconds.tooltip = Time used to blend the cinematic camera back to the player's live first-person view before unlocking it. Default: 0.45.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.LookAtHeight = Look At Height
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.LookAtHeight.tooltip = Height above the player's base that the camera aims toward once tracking begins. Default: 1.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.PositionLerpSpeed = Position Transition Speed
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.PositionLerpSpeed.tooltip = Controls how quickly the camera moves toward its calculated position. Default: 0.15.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.RotationLerpSpeed = Rotation Transition Speed
customUI.triggerVolumeEffectEditor.field.CameraAlongPathPullBack.RotationLerpSpeed.tooltip = Controls how quickly the camera rotates toward its calculated orientation. Default: 0.15.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathSimplified.PullbackDistance = Pullback Distance
customUI.triggerVolumeEffectEditor.field.CameraAlongPathSimplified.PullbackDistance.tooltip = How far the camera moves behind the player by the end of the trigger volume. Default: 16.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathSimplified.VerticalMovement = Vertical Movement
customUI.triggerVolumeEffectEditor.field.CameraAlongPathSimplified.VerticalMovement.tooltip = How far the camera moves vertically along the path. Positive values move upward; negative values move downward. Default: 5.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathSimplified.HorizontalMovement = Horizontal Movement
customUI.triggerVolumeEffectEditor.field.CameraAlongPathSimplified.HorizontalMovement.tooltip = How far the camera moves sideways relative to the path direction. Positive and negative values move toward opposite sides. Use 0 to remain centered. Default: 0.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathSimplified.CameraRollDegrees = Camera Roll (Degrees; 0 = Off)
customUI.triggerVolumeEffectEditor.field.CameraAlongPathSimplified.CameraRollDegrees.tooltip = Final camera tilt in degrees. Use 0 for no roll or a negative value to tilt in the opposite direction. Default: 2.5.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathSimplified.TransitionSpeed = Transition Speed
customUI.triggerVolumeEffectEditor.field.CameraAlongPathSimplified.TransitionSpeed.tooltip = Controls how quickly the camera responds to its changing target. Lower values are slower and smoother. Default: 0.15.
customUI.triggerVolumeEffectEditor.field.CameraAlongPathSimplified.CancelOnBacktracking = Cancel on Backtracking
customUI.triggerVolumeEffectEditor.field.CameraAlongPathSimplified.CancelOnBacktracking.tooltip = If enabled, walking back toward the entrance cancels the cinematic camera until the player exits and re-enters the volume.